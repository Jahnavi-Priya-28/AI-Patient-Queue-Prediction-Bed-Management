PROJECT_NAME="PatientFlow AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Default local PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patientflow_db"

# JWT Authentication Configuration
JWT_SECRET="super-secret-key-change-this-in-production-patientflow-ai-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]

# Gemini GenAI (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

